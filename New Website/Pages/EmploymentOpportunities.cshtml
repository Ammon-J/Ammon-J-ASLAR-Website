@page
@model New_Website.Pages.EmploymentOpportunitiesModel
@{
    ViewData["Employee"] = "Employee";
    ViewData["Title"] = "Employment";
}

<link rel="stylesheet" href="~/css/Employee.css" />
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

<div data-aos="fade-right" data-aos-duration="300">
        <h1>Employment Opportunities</h1>
</div>

    <br />
    <br />

<div data-aos="fade-right" data-aos-duration="600">
        <h4>We are always looking for amazing people to work on our team at ASLAR. Here are some basic requirements for employment:</h4>
</div>

<div class="rightside-requirements">
    <ul style="list-style-type:disc">
        <div data-aos="fade-right" data-aos-duration="1200">
            <li>
                Work independently to deliver Amazon packages to commercial and residential
                customers
            </li>
        </div>

        <div data-aos="fade-right" data-aos-duration="1200">
            <li>
                    Drive a large van, and enter/exit the van multiple times a shift
            </li>
        </div>

        <div data-aos="fade-right" data-aos-duration="1200">
            <li>
                Must be able to move packages up to 50 lbs
            </li>
        </div>
    </ul>
</div>
<div class="leftside-requirements">
    <ul style=“list-style-type:disc”>

        <div data-aos="fade-right" data-aos-duration="1500">
            <li>
                Positive attitude, customer obsessed, and able to work as a team
            </li>
        </div>
         
        <div data-aos="fade-right" data-aos-duration="1500">
            <li>
                21+ years of age
            </li>
        </div>

        <div data-aos="fade-right" data-aos-duration="1500">
            <li>
                Complete a background check, drug test, and driving record review
            </li>
        </div>

        <div data-aos="fade-right" data-aos-duration="1500">
            <li>
                Able to use GPS and basic phone/app
            </li>
        </div>
    </ul>
</div>

<div data-aos="fade-right" data-aos-duration="1800">
    <div class="benefits">
        <h4>Benefits include:</h4>
    </div>
</div>

<div class="rightside-requirements">
    <ul style="list-style-type:disc">
        <div data-aos="fade-right" data-aos-duration="2100">
                <li>
                    Four 10-hour shifts a week
                </li>
        </div>

        <div data-aos="fade-right" data-aos-duration="2400">
            <li>
                Health, dental, and vision insurance
            </li>
        </div>

        <div data-aos="fade-right" data-aos-duration="2700">
            <li>
               PTO (Paid Time Off)
            </li>
        </div>
    </ul>
</div>
<div class="leftside-requirements">
    <ul style=“list-style-type:disc”>
        <div data-aos="fade-right" data-aos-duration="2100">
            <li>
                Team environment
            </li>
    </div>
        <div data-aos="fade-right" data-aos-duration="2400">
            <li>
                Opportunity for leadership/promotion
            </li>
        </div>
        <div data-aos="fade-right" data-aos-duration="2400">
            <li>
                401(k) with company match
            </li>
        </div>
    </ul>
</div>
<br />
<br />

<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script>
    AOS.init();
</script>