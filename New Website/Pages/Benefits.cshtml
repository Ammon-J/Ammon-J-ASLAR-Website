@page
@model New_Website.Pages.Index1Model
@{
    ViewData["Title"] = "Benefits";
}

<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="/css/Benefits.css" />
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

<body>
    <div class="background-image">
    </div>
    <h1>Beyond the Paycheck: Perks that Matter</h1>


    <div class="container-1">
        <div data-aos="fade-up" data-aos-duration="500" style="width: fit-content">
            <div class="benefits-container">
                <h4>Education</h4>
                
                <p class="benefit-text">
                    Invest in your future with up to $5,250 per year toward your education. Whether you’re pursuing 
                    a professional certificate, diploma, or advanced degree, we support your growth. Eligible 
                    employees working at least three days per week can take advantage of this opportunity after 90 
                    days of employment—because your success matters.
                <p>
            </div>
        </div>

        <div data-aos="fade-up" data-aos-duration="600" style="width: fit-content">
            <div class="benefits-container">
                <h4>Dave Ramsey's SmartDollar</h4>
                
                <p class="benefit-text">
                    Learn how to eliminate debt, handle financial emergencies, and plan for your financial success.
                    You also have access to a trained financial coach to answer your money questions.
                </p>
            </div>
        </div>

        <div data-aos="fade-up" data-aos-duration="700" style="width: fit-content">
            <div class="benefits-container ">
                <h4>Insurance</h4>
                
                <p class="benefit-text">
                    We care about your well-being. That’s why all full-time employees are eligible for our health 
                    insurance program, ensuring access to quality care and support. Your coverage begins on the 
                    first of the month following 30 days of employment, so you can focus on what matters most—your 
                    health and peace of mind.
                </p>
            </div>
        </div>

        <div data-aos="fade-up" data-aos-duration="800" style="width: fit-content">
            <div class="benefits-container">
                <h4>Capstone Plus</h4>
                
                <p class="benefit-text">
                    A health and wellness plan where eligible employees receive benefits and see an 
                    increase in their net take-home pay thanks to a provision in the Affordable 
                    Care Act.
                </p>
            </div>
        </div>

        <div data-aos="fade-up" data-aos-duration="900" style="width: fit-content">
            <div class="benefits-container">
                <h4>Childcare Matching</h4>
                
                <p class="benefit-text insurance-text">
                    Do you have young kids? Do you need help finding a childcare? We offer help 
                    finding childcare that matches your needs and budget.
                </p>
            </div>
        </div>

        @* <div data-aos="fade-up" data-aos-duration="1000" style="width: fit-content">
            <div class="benefits-container">
                <h4></h4>
                <br />
                <p class="benefit-text insurance-text">
                    Do you have young kids? Do you need help finding a childcare? We offer help
                    finding childcare that matches your needs and budget.
                </p>
            </div>
        </div> *@

        <div data-aos="fade-up" data-aos-duration="1000" style="width: fit-content">
            <div class="benefits-container">
                <h4>Paid Time Off</h4>
                
                <p class="benefit-text">
                    You are eligible to earn paid time off! You will earn 0.04 hours for every
                    hour worked.
                </p>
            </div>
        </div>

        <div data-aos="fade-up" data-aos-duration="1100" style="width: fit-content">
            <div class="benefits-container">
                <h4>Leadership</h4>
                
                <p class="benefit-text">
                    Great leaders aren’t born—they’re made. Step into a role where your voice 
                    inspires, your decisions create change, and your leadership drives 
                    success. Whether you're looking to refine your skills or take on new 
                    challenges, we offer opportunities for growth, mentorship, and promotion. 
                    Learn how to bring people together, lead with confidence, and achieve 
                    great things as a team!
                </p>
            </div>
        </div>

        <div data-aos="fade-up" data-aos-duration="1300" style="width: fit-content">
            <div class="benefits-container">
                <h4>Friendships</h4>
                
                <p class="benefit-text">
                    Although you may spend much of your day working independently, you are 
                    still a vital part of a supportive team. This role offers meaningful 
                    opportunities to connect with your colleagues, foster lasting 
                    friendships, and build strong, rewarding relationships. Your 
                    contributions matter, and you'll find camaraderie as you grow and 
                    succeed together with your team.
                </p>
            </div>
        </div>
    </div>
</body>
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script>
    AOS.init();
</script>