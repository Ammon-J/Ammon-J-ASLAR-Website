@page
@model New_Website.Pages.Index1Model
@{
    ViewData["Title"] = "Benefits";
}

<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="/css/Benefits.css" />
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

<body>
    <div class="background-image">
    </div>
        <h1>We Offer Benefits!</h1>
</body>

<div class="container-1">
    <div data-aos="fade-up" data-aos-duration="400" style="">
        <div class="benefits-container">
            <h4>Education</h4>
            <br />
            <p class="benefit-text">
                Receive up to $5,250 per year to earn a professional certificate, diploma, or college degree
                (including advanced degrees). To qualify you must work at least three days per week and be
                employed for 90 days.
            <p>
        </div>
    </div>

    <div data-aos="fade-up" data-aos-duration="600" style="">
        <div class="benefits-container">
            <h4>Dave Ramsey's SmartDollar</h4>
            <br />
            <p class="benefit-text">
                Learn how to eliminate debt, handle financial emergencies, and plan for your financial success.
                You also have access to a trained financial coach to answer your money questions.
            </p>
        </div>
    </div>

    <div data-aos="fade-up" data-aos-duration="800" style="">
        <div class="benefits-container">
            <h4>Health, Dental and Vision Insurance</h4>
            <br />
            <p class="benefit-text">
                All full-time employees are eligible to participate in our health insurance program. 
                Eligibility begins the first of the month after 30 days of employment.
            </p>
        </div>
    </div>

    <div data-aos="fade-up" data-aos-duration="1000" style="">
        <div class="benefits-container">
            <h4>Capstone Plus</h4>
            <br />
            <p class="benefit-text">
                A health and wellness plan where eligible employees receive benefits and see an 
                increase in their net take-home pay thanks to a provision in the Affordable 
                Care Act.
            </p>
        </div>
    </div>

    <div data-aos="fade-up" data-aos-duration="1200" style="">
        <div class="benefits-container">
            <h4>Childcare Matching</h4>
            <br />
            <p class="benefit-text">
                Get help finding childcare that matches your needs and budget.
            </p>
        </div>
    </div>

    <div data-aos="fade-up" data-aos-duration="1200" style="">
        <div class="benefits-container">
            <h4>401(k) Contributions</h4>
            <br />
            <p class="benefit-text">
                We are pleased to offer a 401(k) retirement plan with company 
                match. All employees are automatically enrolled in the 
                program after 90 days of employment. Initial contribution 
                amount is set at 7% of the employees pay, and the Company 
                matches up to 4%.
            </p>
        </div>
    </div>
</div>
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script>
    AOS.init();
</script>