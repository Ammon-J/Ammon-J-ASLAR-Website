<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - New_Website</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/New_Website.styles.css" asp-append-version="true" />

    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@200&family=PT+Sans&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3" style="background-color: #0b5ab5; margin-bottom: 0% !important">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index"><img src="/Logo/aslar logistics-clear.png" alt="" height="70"></a>
                <button class="navbar-toggler" style="background-color: azure" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light" aria-current="page" asp-area="" asp-page="/EmploymentOpportunities">Employment</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" aria-current="page" asp-area="" asp-page="/FAQ">FAQ</a>
                        </li>
                    </ul>
                    <a class="btn btn-primary" href="https://www.indeed.com/cmp/Aslar-Logistics/jobs" role="button" target="_blank">Apply Now</a> <!--Add links above this statement-->
                </div>
            </div>
        </nav>

    </header>

    @{
        if (ViewData["Title"] != null) {
            <div class="container" style="max-width: 100% !important; padding: 0% !important;">
                <main role="main" style="margin: 0%; width:100%" class="pb-3">
                    @RenderBody()
                </main>
            </div>

            <footer class="footer" style="margin-bottom: 3em">
                <div class="container" style="text-align:center">
                    <br />
                    <div class="contact">
                        <p class="email-footer" style="color: black">recruiting@aslarlogistics.com</p>
                        <a class="btn btn-primary" id="appy-button" href="https:www.indeed.com/cmp/Aslar-Logistics/jobs"
                        role="button" target="_blank" style="width:20%; height:15%">Apply Now</a>
                        <p class="phone-footer" style="color: black">253-219-1072</p>
                    </div>
                </div>
            </footer>
        }

        else {
            <div class="container">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>

            <footer class="border-top footer" style="margin-bottom: 5em">
                <div class="container" style="text-align:center">
                    <br />
                    <br />
                    <a class="btn btn-primary" href="https://www.indeed.com/cmp/Aslar-Logistics/jobs"
                        role="button" target="_blank" style="width:20%; height:15%">Apply Now</a>
                </div>
            </footer>
        }
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>