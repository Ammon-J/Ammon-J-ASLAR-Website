@*Documentation for Bootstrap icon
    https://icons.getbootstrap.com/#install
*@

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="shortcut icon" href="/Logo/ASLAR Logo Icon.ico" type="image/x-icon">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/New_Website.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@200&family=PT+Sans&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar fixed-top navbar-expand-sm navbar-toggleable-sm navbar-light mb-3" style="background-color: #0b5ab5; margin-bottom: 0% !important">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index"><img src="/Logo/Color logo white letter Clear.png" alt="" height="90"></a>
                <button class="navbar-toggler" style="background-color: azure" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light" aria-current="page" asp-area="" asp-page="/EmploymentOpportunities">Employment</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" aria-current="page" asp-area="" asp-page="/Benefits">Benefits</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" aria-current="page" asp-area="" asp-page="/FAQ">FAQ</a>
                        </li>
                    </ul>
                    <a class="btn btn-primary" href="https://www.indeed.com/cmp/Aslar-Logistics/jobs" role="button" target="_blank">Apply Now</a> <!--Add links above this statement-->
                </div>
            </div>
        </nav>

    </header>

    <div class="main-body">
        @{
            if (ViewData["Title"] == "ASLAR Logistics") {
                <div class="container" style="max-width: 100% !important; padding: 0% !important;">
                    <main role="main" style="margin: 0%; width:100%" class="pb-3">
                        @RenderBody()

                        <footer class="main-footer">
                            <div class="container p-4">
                                <div class="row">
                                    <div class="col-lg-6 col-md-12 mb-4">
                                        <h5 class="mb-3" style="letter-spacing: 2px;">Contact</h5>
                                        <p><i class="bi bi-house "></i><a target="_blank" href="https://tinyurl.com/3pr3ycps"> 3711 142nd Ave E, Sumner, WA 98390</a></p>
                                        <p><i class="bi bi-envelope "></i><a href="mailto:recruiting@aslarlogistics.com">  recruiting@aslarlogistics.com</a></p>
                                        <p><i class="bi bi-phone mr-3"><a href="tel:+12533652902"> +1 (253)-365-2902</a></i></p>
                                    </div>
                                    <div class="col-lg-3 col-md-6 mb-4">
                                        <h5 class="mb-3" style="letter-spacing: 2px">Links</h5>
                                        <ul class="list-unstyled mb-0">
                                            <li class="mb-1">
                                                <a asp-page="/Index" >Home</a>
                                            </li>
                                            <li class="mb-1">
                                                <a asp-page="#!">About</a>
                                            </li>
                                            <li class="mb-1">
                                                <a a asp-page="#!">Testimonies</a>
                                            </li>
                                            <li>
                                                <a asp-page="/FAQ" >FAQ</a>
                                            </li>
                                        </ul>
                                    </div>
                                    <div class="col-lg-3 col-md-6 mb-4">
                                        <h5 class="mb-1" style="letter-spacing: 2px; color: azure;">Office Hours</h5>
                                        <table class="table" style="color: azure; border-color: azure;">
                                            <tbody>
                                                <tr>
                                                    <td>Mon - Fri:</td>
                                                    <td>8am - 4pm</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </footer>
                    </main>
                </div>
            }

            else {
                <div class="mainbody">
                    <div class="container">
                        <main role="main" class="pb-3">
                            @RenderBody()

                            <footer class="main-footer">
                                <div class="container p-4">
                                    <div class="row">
                                        <div class="col-lg-6 col-md-12 mb-4">
                                            <h5 class="mb-3" style="letter-spacing: 2px;">Contact</h5>
                                            <p><i class="bi bi-house "></i><a target="_blank" href="https://tinyurl.com/3pr3ycps"> 3711 142nd Ave E, Sumner, WA 98390</a></p>
                                            <p><i class="bi bi-envelope "></i><a href="mailto:recruiting@aslarlogistics.com">  recruiting@aslarlogistics.com</a></p>
                                            <p><i class="bi bi-phone mr-3"><a href="tel:+12533652902"> +1 (253)-365-2902</a></i></p>
                                        </div>
                                        <div class="col-lg-3 col-md-6 mb-4">
                                            <h5 class="mb-3" style="letter-spacing: 2px">Links</h5>
                                            <ul class="list-unstyled mb-0">
                                                <li class="mb-1">
                                                    <a asp-page="/Index">Home</a>
                                                </li>
                                                <li class="mb-1">
                                                    <a asp-page="#!">About</a>
                                                </li>
                                                <li class="mb-1">
                                                    <a a asp-page="#!">Testimonies</a>
                                                </li>
                                                <li>
                                                    <a asp-page="/FAQ">FAQ</a>
                                                </li>
                                            </ul>
                                        </div>
                                        <div class="col-lg-3 col-md-6 mb-4">
                                            <h5 class="mb-1" style="letter-spacing: 2px; color: azure;">Office Hours</h5>
                                            <table class="table" style="color: azure; border-color: azure;">
                                                <tbody>
                                                    <tr>
                                                        <td>Mon - Fri:</td>
                                                        <td>8am - 4pm</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </footer>
                        </main>
                    </div>
                </div>
            }
        }
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>