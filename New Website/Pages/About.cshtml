@page
@model New_Website.Pages.EmploymentOpportunitiesModel
@{
    ViewData["Title"] = "About";
}
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<link rel="stylesheet" href="~/css/About.css" />
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

<div data-aos="fade-right" data-aos-duration="300">
        <h1 class="main-header">About</h1>
</div>

<!-- Swiper -->
<div class="swiper">
    <div class="swiper-wrapper">
        <div class="swiper-slide"><img src="/Slideshow-Photos/Tezza-0005.JPG" style="height: 60vh; border-radius: 15px;"></div>
        <div class="swiper-slide"><img src="/Slideshow-Photos/Tezza-0080.JPG" style="height: 60vh; border-radius: 15px;"></div>
        <div class="swiper-slide"><img src="/Slideshow-Photos/Tezza-4163.JPG" style="height: 60vh; border-radius: 15px;"></div>
        <div class="swiper-slide"><img src="/Slideshow-Photos/Tezza-4490.JPG" style="height: 60vh; border-radius: 15px;"></div>
        <div class="swiper-slide"><img src="/Slideshow-Photos/Tezza-5535.JPG" style="height: 60vh; border-radius: 15px;"></div>
        <div class="swiper-slide"><img src="/Slideshow-Photos/Tezza-6285.JPG" style="height: 60vh; border-radius: 15px;"></div>
        <div class="swiper-slide"><img src="/Slideshow-Photos/Tezza-7976.JPG" style="height: 60vh; border-radius: 15px;"></div>
        <div class="swiper-slide"><img src="/Slideshow-Photos/Tezza-8784.JPG" style="height: 60vh; border-radius: 15px;"></div>
    </div>
    
    <!-- Add Pagination -->
    <div class="swiper-pagination"></div>
</div>

<div class="container-1">
    <h1 class="container-1-header">ASLAR Logistics</h1>
    <div class="container-1-content">
        <p class="container-1-text">
            ASLAR Logistics is a small delivery business here in Sumner WA.
            ASLAR Logistics has a contract with Amazon to deliver 
            their packages. ASLAR Logistics is a separate company
            but we are based in an Amazon Delivery Center.
        </p>
    </div>
</div>

<div class="container-2">
    <h1 class="container-2-header">What does a normal day look like?</h1>
</div>

<div class="container-3">
    <h1 class="container-3-header">Testimonies</h1>
    <div class="testimony-container">
        <div class="testimony-1">
            <img class="testimony-1-photo" src="/Recruiting Video and Photos/Ashley.JPG" alt="" />
            <p class="testimony-1-text">
                The company and the people have here, its a great environment, a great group,
                a great management and they treat us employees very well. -Ashley
            </p>
        </div>
        <div class="testimony-2">
            <img src="/Recruiting Video and Photos/Sannara.jpg" class="testimony-2-photo" alt="" />
            <p class="testimony-2-text">
                I love the team I work for. We have great team managers and associates that drive.
                Everyone is always willing to help. -Sannara
            </p>
        </div>
        <div class="testimony-3">
            <img src="/Recruiting Video and Photos/Karen.png" class="testimony-3-photo" alt="">
            <p class="testimony-3-text">
                You know its always who you work with and who you work for that makes it that much better. 
                Thats what kept me here so long. Great team in general, its like a big family. -Karen
            </p>
        </div>
        <div class="testimony-4">
            <img src="/Recruiting Video and Photos/Glen.png" class="testimony-4-photo" alt="" />
            <p class="testimony-4-text">
                I can change my schedule around if I need to go to class or take care of my family. - Glen
            </p>
        </div>
    </div>
</div>

<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script type="module">
    AOS.init();

        import Swiper from 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.mjs'
        var swiper = new Swiper('.swiper', {
          slidesPerView: 1,
          grabCursor: true,
          centeredSlides: true,
          loop: true,
          grabCursor: true,
          effect: 'coverflowEffect',
          coverflowEffect: {
            rotate: 10,
            stretch: 0,
            depth: 10,
            modifier: 1,
            slideShadows: true,
          },
          autoplay: {
            delay: 2500,
            disableOnInteraction: false,
          },
          pagination: {
            el: '.swiper-pagination',
          },
        });
</script>