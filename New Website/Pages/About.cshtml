        <h1 class="main-header">Who We Are</h1>
</div>

<div data-aos="fade-up" data-aos-duration="700">
    <!-- Swiper -->
    <div class="swiper">
        <div class="swiper-wrapper">
            <div class="swiper-slide"><img src="/Slideshow-Photos/Tezza-8784.JPG" class="slide-photo"></div>
            <div class="swiper-slide"><img src="/Slideshow-Photos/Tezza-9433.JPG" class="slide-photo"></div>
            <div class="swiper-slide"><img src="/Slideshow-Photos/Tezza-0005.JPG" class="slide-photo"></div>
            <div class="swiper-slide"><img src="/Slideshow-Photos/Tezza-5481.JPG" class="slide-photo"></div>
            <div class="swiper-slide"><img src="/Slideshow-Photos/Tezza-4163.JPG" class="slide-photo"></div>
            <div class="swiper-slide"><img src="/Slideshow-Photos/Tezza-5535.JPG" class="slide-photo"></div>
            <div class="swiper-slide"><img src="/Slideshow-Photos/Tezza-4490.JPG" class="slide-photo"></div>
            <div class="swiper-slide"><img src="/Slideshow-Photos/Tezza-6285.JPG" class="slide-photo"></div>
            <div class="swiper-slide"><img src="/Slideshow-Photos/Tezza-7976.JPG" class="slide-photo"></div>
            <div class="swiper-slide"><img src="/Slideshow-Photos/Tezza-0080.JPG" class="slide-photo"></div>
