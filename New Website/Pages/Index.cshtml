@page
@model IndexModel
@{
    ViewData["Title"] = "ASLAR Logistics";
}

<link rel="stylesheet" href="/css/Homepage.css" />
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
<body>
    <div data-aos="fade-up" data-aos-duration="500">
        <h1 class="main-header">Where Work Feels Like Family</h1>
    </div>

    <div class="container1">
        <div data-aos="fade-up" data-aos-duration="600">
            <p class="paragraph1">
                ASLAR Logistics is proud to be an Amazon Delivery Service Partner (DSP). Our mission? To deliver 
                exceptional service to Amazon’s customers—safely, efficiently, and with a smile! We’re 
                searching for enthusiastic individuals with a positive attitude, high energy, and a passion for 
                teamwork. If you’re ready to join a supportive team that values its people and embraces new 
                challenges, we’d love to have you on board!
            </p>
        </div>
    </div>
        

    <div class="container-2">
        <div data-aos="fade-up" data-aos-duration="700">
            <h1 class="container-2-header">Come Work For Us!</h1>
        </div>
        <div class="content-grid">
            <div class="requirements-container-left">
                <div data-aos="fade-up" data-aos-duration="800">
                        <h1 class="requirements-header-left">What you need:</h1>
                </div>
                <div data-aos="fade-up" data-aos-duration="900">
                        <ul>
                            <li>21+ years of age</li>
                            <li>Drive a large van, and enter/exit the van multiple times a shift</li>
                            <li>Work four 10-hour shifts a week</li>
                            <li>Able to work in a team environment</li>
                            <li>Able to use GPS and basic phone/app</li>
                            <li>Must be able to move packages up to 50 lbs</li>
                        </ul>
                </div>
            </div>
            <div class="requirements-container-right">
                <div data-aos="fade-up" data-aos-duration="800">
                    <h1 class="requirements-header-right">What you get:</h1>
                </div>
                <div data-aos="fade-up" data-aos-duration="900">
                    <ul>
                        <li>
                            Work independently to deliver Amazon packages to commercial and residential
                            customers
                        </li>
                        <li>Average pay of $23 per hour</li>
                        <li>Health, dental, and vision insurance</li>
                        <li>PTO (Paid Time Off)</li>
                        <li>Opportunity for leadership/promotion</li>
                        <li>401(k) with company match</li>
                        <li>Continuing Education benefit to earn a GED, Certificate, or Bachelor’s Degree</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div data-aos="fade-up" data-aos-duration="800">
        <video class="main-video" autoplay muted width="900" height="500" controls controlsList="nodownload" poster="/Recruiting Video and Photos/Main Video Cover Photo.png">
            <source src="/Recruiting Video and Photos/ASLAR Logistics Recruiting Video.MP4" type="video/mp4" />
        </video>
    </div>

    <div class="container-3">
        <div data-aos="fade-up" data-aos-duration="800">
            <h1 class="container-3-header">Where should I start?</h1>
        </div>
       
        <div class="container-3-btn">
            <div data-aos="fade-up" data-aos-duration="1000">
                <a type="button" target="_blank" class="btn btn-outline-primary btn-lg" href="https://www.indeed.com/cmp/Aslar-Logistics/jobs">Apply Here On Indeed</a>
            </div>
        </div>
    </div>
</body>

<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script>
    AOS.init();
</script>
