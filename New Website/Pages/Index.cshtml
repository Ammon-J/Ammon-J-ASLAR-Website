@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

@*
    I love the team I work for. We have great team managers and associates that drive. 
    Everyone is always willing to help. -Sannara

    The company and the people have here, its a great environment, great group,
    great management and the treat us employees very well. -Ashley

    I love the team I work with. You know its always who you work with and who you work for 
    that makes it that much better. Thats what kept me here so long. Great team in general, 
    its like a big family. -Karen
*@

<link rel="stylesheet" href="/css/Homepage.css" />
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

<div data-jarallax data-parallax="scroll" class="jarallax">
    <h1 class="main-header">Welcome</h1>
    
    <video class="main-video" width="900" height="500" controls controlsList="nodownload" poster="/Recruiting Video/Main Video Cover Photo.png">
        <source src="/Recruiting Video and Photos/ASLAR Logistics Recruiting Video.MP4" type="video/mp4" />
    </video>
        
    <img src="https://via.placeholder.com/600x400" class="first-page-image-left" alt="" />

    <p class="first-page-content-right">
        I love the team I work with. You know its always who you work with and who you work for 
        that makes it that much better. Thats what kept me here so long. Great team in general, 
        its like a big family. -Karen
    </p>

    <img class="jarallax-img" src="/Logo/logo-background.jpg" alt="">
</div>

<div data-jarallax data-parallax="scroll" class="jarallax" style="background-color:#0b5ab5">
    <div class="format-spacer">
        <p></p>
    </div>

    <img src="https://via.placeholder.com/600x400" class="second-page-image-right-top" alt="" />

    <p class="second-page-content-left-top">
        The company and the people have here, its a great environment, a great group,
        a great management and they treat us employees very well. -Ashley
    </p>

    <img src="https://via.placeholder.com/600x400" class="second-page-image-left-bottom" alt="" />

    <p class="second-page-content-right-bottom">
        I love the team I work for. We have great team managers and associates that drive. 
        Everyone is always willing to help. -Sannara
    </p>

    <img class="jarallax-img" src="/Logo/logo-clear-background.png" alt="">
</div>

<script src="https://unpkg.com/jarallax@1/dist/jarallax.min.js"></script>
<script>
    jarallax(document.querySelectorAll('.jarallax'), {
        onScroll: function (calculations) {
            console.log(calculations);
        }
    });

    console.log(jarallax(document.querySelectorAll('.jarallax'), 'isVisible'));
</script>
